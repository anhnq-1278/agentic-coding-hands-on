# Google OAuth client (https://console.cloud.google.com/ → APIs & Services → Credentials)
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/auth/callback
GOOGLE_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-CLIENT-SECRET

# Random 32+ character string used to sign session JWTs.
# Generate with: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-32-plus-char-random-string

# Comma-separated list of email domains allowed to authenticate (Sun* whitelist)
ALLOWED_EMAIL_DOMAINS=sun-asterisk.com

# Public base URL used to build the OAuth redirect URI (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Homepage SAA — event datetime in ISO-8601 format, drives the countdown.
EVENT_START_AT=2025-12-26T18:30:00+07:00

# Optional overrides for the event-info block. Defaults match the design copy.
EVENT_LOCATION=Âu Cơ Art Center
EVENT_LIVESTREAM_NOTE=Tường thuật trực tiếp qua sóng Livestream
